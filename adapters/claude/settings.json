{
  "$schema": "https://claude.ai/schemas/settings.json",
  "_comment": "Claude Code hooks for multimodel-dev-os. Copy to .claude/settings.json in your project root.",

  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "echo '[hook] Session started at %DATE% %TIME%' >> .ai/session-logs/hooks.log"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|replace_file",
        "type": "command",
        "command": "node scripts/verify.js --quiet 2>&1 || echo '[hook] verify.js reported warnings'"
      }
    ]
  },

  "permissions": {
    "allow": [
      "read_file",
      "list_directory",
      "search_files",
      "run_command"
    ],
    "deny": []
  }
}
