{
  "title": "Gateway Client Profile",
  "type": "object",
  "required": ["id", "name", "category", "status", "protocol", "endpoint_style", "supports_base_url", "supports_model_override", "supports_streaming", "supports_tools", "supports_custom_headers", "supports_bearer_token", "configuration_formats", "configuration_locations", "executable_mock_models", "limitations"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string" },
    "category": { "enum": ["coding-agent", "editor-extension", "cli", "mcp-client", "generic-sdk", "custom-client"] },
    "status": { "enum": ["validated", "example-only", "adapter-ready", "unsupported", "needs-manual-review"] },
    "protocol": { "enum": ["openai-chat-completions", "openai-compatible", "mcp", "custom-http"] },
    "endpoint_style": { "type": "string" },
    "supports_base_url": { "type": "boolean" },
    "supports_model_override": { "type": "boolean" },
    "supports_streaming": { "type": "boolean" },
    "supports_tools": { "type": "boolean" },
    "supports_custom_headers": { "type": "boolean" },
    "supports_bearer_token": { "type": "boolean" },
    "configuration_formats": { "type": "array", "items": { "type": "string" } },
    "configuration_locations": { "type": "array", "items": { "type": "string" } },
    "executable_mock_models": { "type": "array", "items": { "enum": ["mock-chat", "mock-tools", "mock-stream"] } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}
