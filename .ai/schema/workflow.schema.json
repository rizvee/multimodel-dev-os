{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MultiModel Dev OS Workflow Registry Schema",
  "description": "Schema for workflow registry entries with optional declarative Skill OS metadata.",
  "type": "object",
  "required": ["workflows"],
  "properties": {
    "workflows": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/workflow"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "workflow": {
      "type": "object",
      "required": ["name", "description", "risk_level", "steps"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "risk_level": { "type": "string", "enum": ["low", "medium", "high", "restricted"] },
        "allowed_to_write_memory": { "type": "boolean" },
        "allowed_to_modify_source": { "type": "boolean" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/step" }
        },
        "commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expected_outputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "next_action": { "type": "string" },
        "skill_os": { "$ref": "#/definitions/skill_os" }
      },
      "additionalProperties": true
    },
    "step": {
      "type": "object",
      "required": ["name", "command"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "expected_output": { "type": "string" },
        "next_action": { "type": "string" }
      },
      "additionalProperties": true
    },
    "skill_os": {
      "type": "object",
      "properties": {
        "skills": { "$ref": "#/definitions/slug_list" },
        "prompts": { "$ref": "#/definitions/slug_list" },
        "permissions": { "$ref": "#/definitions/slug_list" },
        "guardrails": { "$ref": "#/definitions/slug_list" },
        "required_context": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "slug_list": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  }
}
