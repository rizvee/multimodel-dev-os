{
  "$id": "mmdo.gateway-credential-resolution-result",
  "title": "Gateway Credential Resolution Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "resolved", "provider_id", "source"],
  "properties": {
    "contract_version": { "type": "string", "enum": ["2026-07-15.sprint-a"] },
    "resolved": { "type": "boolean" },
    "provider_id": { "type": "string", "minLength": 1 },
    "env_var": {
      "type": ["string", "null"],
      "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
    },
    "source": { "type": "string", "enum": ["environment"] }
  }
}
