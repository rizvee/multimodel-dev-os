{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MultiModel Dev OS Agent Cluster Registry Schema",
  "description": "Schema for optional agent cluster routing metadata. Sprint A is declarative only and does not execute clusters.",
  "type": "object",
  "required": ["agent_clusters"],
  "properties": {
    "agent_clusters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/agentCluster"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "agentCluster": {
      "type": "object",
      "required": ["id", "name", "description", "scope", "typical_skills", "allowed_tool_classes", "required_context", "outputs", "validation_expectations"],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["core-technical", "growth-marketing", "business-ops", "devops-security", "document-production", "academic-execution"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "typical_skills": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "allowed_tool_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["read-only", "draft-only", "write-with-confirmation", "restricted-admin"]
          }
        },
        "required_context": {
          "type": "array",
          "items": { "type": "string" }
        },
        "outputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "validation_expectations": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}
