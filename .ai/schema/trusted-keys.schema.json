{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MultiModel Dev OS Trusted Keys Schema",
  "description": "JSON schema defining trusted publisher keys for remote registry signature verification",
  "type": "object",
  "required": [
    "trusted_publishers"
  ],
  "properties": {
    "trusted_publishers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "name",
          "algorithm",
          "public_key",
          "scopes",
          "status"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "description": "Unique identifier of the trusted key.",
            "pattern": "^[a-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "description": "Name of the publisher associated with the key."
          },
          "algorithm": {
            "type": "string",
            "enum": [
              "ed25519",
              "hmac-sha256",
              "gpg"
            ],
            "description": "Cryptographic signature algorithm."
          },
          "public_key": {
            "type": "string",
            "description": "PEM-encoded public key or raw base64 key string."
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "registry",
                "catalog"
              ]
            },
            "minItems": 1,
            "description": "Allowed scopes for this key."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "revoked",
              "disabled"
            ],
            "description": "Key status."
          },
          "added_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of when the key was added to the trust store."
          },
          "remote_source_url": {
            "type": "string",
            "pattern": "^https://",
            "description": "HTTPS URL from which the public key was fetched (remote key sync provenance)."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
