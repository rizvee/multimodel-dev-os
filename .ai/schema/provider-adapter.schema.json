{
  "$id": "mmdo.provider-adapter",
  "title": "Provider Adapter Contract",
  "type": "object",
  "required": ["id", "name", "type", "version", "capabilities", "credential_env", "base_url", "models"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["openai-compatible", "native", "local", "mock"]
    },
    "version": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["chat", "streaming", "tools", "vision", "audio", "reasoning", "embeddings", "local", "structured-output"]
      }
    },
    "credential_env": { "type": ["string", "null"] },
    "base_url": { "type": "string", "minLength": 1 },
    "models": { "type": "array", "minItems": 1 }
  }
}
