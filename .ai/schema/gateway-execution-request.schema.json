{
  "$id": "mmdo.gateway-execution-request",
  "title": "Gateway Execution Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "provider_id", "model_id", "gateway_request", "options"],
  "properties": {
    "contract_version": { "type": "string", "enum": ["2026-07-15.sprint-a"] },
    "request_id": { "type": "string", "minLength": 1 },
    "provider_id": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "gateway_request": { "type": "object" },
    "credential_ref": { "type": ["object", "null"] },
    "endpoint": { "type": ["object", "null"] },
    "policy": { "type": ["object", "null"] },
    "capability": { "type": ["object", "null"] },
    "options": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "max_response_bytes": { "type": "integer", "minimum": 1 },
        "stream": { "type": "boolean" },
        "follow_redirects": { "type": "boolean", "enum": [false] }
      }
    },
    "metadata": { "type": "object" }
  }
}
