{
  "$id": "mmdo.gateway-credential-reference",
  "title": "Gateway Credential Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "source", "env_var"],
  "properties": {
    "contract_version": { "type": "string", "enum": ["2026-07-15.sprint-a"] },
    "source": { "type": "string", "enum": ["environment"] },
    "env_var": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
    },
    "required": { "type": "boolean" }
  }
}
